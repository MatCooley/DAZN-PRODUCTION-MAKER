rules_version = '2';

// Gated on Firebase Anonymous Auth (silent — no login screen, the app
// signs everyone in automatically). This isn't per-user access control,
// just a floor that keeps the data off the open internet: a browser has
// to actually load and run the app's Firebase SDK to get a token before
// Firestore will talk to it, unlike the earlier `if true` rule anyone
// with curl could read or write against directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /app/rosterState {
      allow read, write: if request.auth != null;
    }
  }
}
